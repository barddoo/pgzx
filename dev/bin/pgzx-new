#!/usr/bin/env bash
#
# Create a new pgzx extension project from the init template.
#
# Usage: pgzx-new <name> [dir]
#   name: extension name, lowercase letters, digits and underscores
#   dir:  destination directory, default ./<name>
#
# The template lives in nix/templates/init. Every `my_extension` in file names
# and contents is replaced with <name>. Works without Nix; the generated
# project still needs the Zig and PostgreSQL tools from its devshell to build.

set -euo pipefail

usage() {
	echo "Usage: $(basename "$0") <name> [dir]" >&2
	exit 2
}

[ $# -ge 1 ] && [ $# -le 2 ] || usage
name=$1
dest=${2:-$name}

if ! [[ $name =~ ^[a-z][a-z0-9_]*$ ]]; then
	echo "pgzx-new: invalid name '$name': use lowercase letters, digits and underscores, starting with a letter" >&2
	exit 2
fi

script_dir=$(cd "$(dirname "$0")" && pwd)
template="$script_dir/../../nix/templates/init"
if [ ! -d "$template" ]; then
	echo "pgzx-new: template not found at $template" >&2
	exit 1
fi

if [ -e "$dest" ]; then
	echo "pgzx-new: '$dest' already exists" >&2
	exit 1
fi

cp -R "$template" "$dest"

# Rename from the deepest path first so parent directories are still valid.
find "$dest" -depth -name '*my_extension*' | while IFS= read -r path; do
	base=$(basename "$path")
	new_base=${base//my_extension/$name}
	mv "$path" "$(dirname "$path")/$new_base"
done

find "$dest" -type f -exec perl -pi -e "s/my_extension/$name/g" {} +

echo "Created pgzx extension '$name' in $dest"

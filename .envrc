# shellcheck shell=bash
: "${XDG_CACHE_HOME:=$HOME/.cache}"

# Keep the flake profile out of the repo (in the XDG cache) and key it by the
# project path only. Keying it by the *contents* of the flake files, as the
# previous version did, threw the profile away on every edit to flake.nix,
# flake.lock or devshell.nix: the next `nix print-dev-env` then had to build
# the shell from scratch (~5s, or a full download/build after a flake update)
# instead of updating the existing profile incrementally.
direnv_layout_dir() {
	local pwd_hash
	pwd_hash=$(basename "$PWD")-$(printf '%s' "$PWD" | shasum | cut -d ' ' -f 1 | head -c 7)
	echo "$XDG_CACHE_HOME/direnv/layouts/$pwd_hash"
}

# Reload when anything that shapes the dev shell changes. flake.nix/flake.lock
# are also watched by `use flake`; the rest are imported by it.
watch_file flake.nix flake.lock devshell.nix nix/modules/nixpkgs.nix
use flake

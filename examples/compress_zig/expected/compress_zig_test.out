CREATE EXTENSION compress_zig;
SET search_path TO compress_zig;
-- A table that exercises each codec family:
--   id      monotonic   -> delta
--   device  low-card    -> rle / dict
--   reading floats      -> gorilla / dict
--   label   text        -> dictionary / plain
--   ok      boolean     -> bitmap
CREATE TABLE events (
    id bigint,
    device int,
    reading float8,
    label text,
    ok boolean
);
INSERT INTO events VALUES
    (1, 1, 1.5,  'alpha', true),
    (2, 1, 1.5,  'alpha', false),
    (3, 2, 2.25, 'beta',  true),
    (4, 2, 2.25, 'beta',  false),
    (5, 3, 3.5,  'gamma', true),
    (6, 3, NULL, NULL,    NULL);
SELECT compress_table('events');
 compress_table 
----------------
              6
(1 row)

SELECT batch_count('events');
NOTICE:  schema "_compress_zig" already exists, skipping
NOTICE:  relation "batches" already exists, skipping
 batch_count 
-------------
           1
(1 row)

SELECT decompress_table('events');
                                                                                                                                                                             decompress_table                                                                                                                                                                              
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 [{"id":1,"device":1,"reading":1.5,"label":"alpha","ok":true},{"id":2,"device":1,"reading":1.5,"label":"alpha","ok":false},{"id":3,"device":2,"reading":2.25,"label":"beta","ok":true},{"id":4,"device":2,"reading":2.25,"label":"beta","ok":false},{"id":5,"device":3,"reading":3.5,"label":"gamma","ok":true},{"id":6,"device":3,"reading":null,"label":null,"ok":null}]
(1 row)

-- The decompressed JSON can be queried like a table, including NULLs.
SELECT (obj->>'id')::bigint AS id, obj->>'label' AS label, obj->>'reading' AS reading
FROM jsonb_array_elements(decompress_table('events')::jsonb) AS obj
ORDER BY 1;
 id | label | reading 
----+-------+---------
  1 | alpha | 1.5
  2 | alpha | 1.5
  3 | beta  | 2.25
  4 | beta  | 2.25
  5 | gamma | 3.5
  6 |       | 
(6 rows)

-- Compressing again is idempotent (the previous batches are replaced).
SELECT compress_table('events');
NOTICE:  schema "_compress_zig" already exists, skipping
NOTICE:  relation "batches" already exists, skipping
 compress_table 
----------------
              6
(1 row)

SELECT batch_count('events');
NOTICE:  schema "_compress_zig" already exists, skipping
NOTICE:  relation "batches" already exists, skipping
 batch_count 
-------------
           1
(1 row)

-- The source table is left untouched.
SELECT count(*) FROM events;
 count 
-------
     6
(1 row)

DROP TABLE events;
DROP EXTENSION compress_zig;
